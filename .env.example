# Copy to .env.local and fill in the values:  cp .env.example .env.local
# .env.local is gitignored. Never put real values in this file.

# --- Convex ------------------------------------------------------------------
# Written automatically by `npx convex dev`.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# HTTP actions (webhooks) URL: the same deployment name, ending in .convex.site
NEXT_PUBLIC_CONVEX_SITE_URL=

# --- Clerk (installed, not wired into the app yet) ---------------------------
# From the Clerk Dashboard → API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Set on Convex, NOT in this file (webhook handlers run on Convex's servers) ---
#   npx convex env set CLERK_WEBHOOK_SIGNING_SECRET whsec_...   (Clerk → Webhooks → endpoint)
